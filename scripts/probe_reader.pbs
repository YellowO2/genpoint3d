#!/bin/bash
# Does the matcher alone know where the point is? (scripts/probe_reader.py)
#
#   qsub -v CKPT=outputs/fyO_joint_long/best.pt scripts/probe_reader.pbs
#   qsub -v CKPT=outputs/fyO_joint_long/best.pt,FINE_WEIGHTS=weights/tapip3d_finder.pt scripts/probe_reader.pbs
#   qsub -v CKPT=outputs/fyO_joint_long/best.pt,OUT=renders/matcher scripts/probe_reader.pbs
#
#PBS -N probe_reader
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=01:30:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/probe_reader.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

# FINE_WEIGHTS (relative to ~/scratch) puts other weights into the matcher.
[ -n "${FINE_WEIGHTS:-}" ] && FW="--fine-weights $ROOT/$FINE_WEIGHTS" || FW=""
# OUT (relative to ~/scratch) also tracks with the matcher alone and draws it.
[ -n "${OUT:-}" ] && O="--out $ROOT/$OUT --clips ${CLIPS:-6}" || O=""
python scripts/probe_reader.py --ckpt "$CKPT" $FW --push ${PUSH:-16} --steps ${STEPS:-3000} $O
