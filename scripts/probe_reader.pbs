#!/bin/bash
# Can the score tables alone say how far a point moved? (scripts/probe_reader.py)
#
#   qsub -v FINE_INIT=weights/cotracker3_fnet.pt scripts/probe_reader.pbs
#
#PBS -N probe_reader
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=01:30:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/probe_reader.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

python scripts/probe_reader.py --cache $ROOT/cache/kubric_ctr --frames-cache $ROOT/cache/kubric_frames384 \
  --fine 1 --dino 0 --batch 8 --points 128 --fine-init $ROOT/${FINE_INIT:-weights/cotracker3_fnet.pt} \
  --push ${PUSH:-16} --probe-steps ${STEPS:-3000}
