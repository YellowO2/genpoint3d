#!/bin/bash
# Cache the optical flow between neighbouring frames of every clip in a frames
# cache (scripts/cache_flow.py), with SEA-RAFT pretrained and frozen.
#
#   qsub -v FRAMES=cache/kubric_frames384,DST=cache/kubric_flow384 scripts/cache_flow.pbs
#
# Paths are relative to ~/scratch. Needs a SEA-RAFT clone at
# references/searaft/repo and its weights at weights/searaft-spring-M
# (huggingface_hub.snapshot_download of MemorySlices/Tartan-C-T-TSKH-spring540x960-M).
# ONLY=fit_check/tuO/val does just that directory's clips. Resubmitting resumes.
#
#PBS -N cache_flow
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=02:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/cache_flow.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

python scripts/cache_flow.py --frames $ROOT/${FRAMES:?} --dst $ROOT/${DST:?} \
  --repo references/searaft/repo --weights $ROOT/weights/searaft-spring-M ${LIMIT:+--limit $LIMIT} ${ONLY:+--only $ROOT/$ONLY}

echo "=== CACHE FLOW DONE ==="
