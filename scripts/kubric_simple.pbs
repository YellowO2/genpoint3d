#!/bin/bash
# Render N simple Kubric clips (scripts/kubric_simple_worker.py) into the layout
# KubricSequenceDataset reads: $OUT/<id>/<id>.npy and $OUT/<id>/frames/.
# Clip i is seeded FIRST+i, so separate jobs with different FIRST never collide,
# and a clip already written is skipped.
#
#   qsub -v N=2,RES=256 scripts/kubric_simple.pbs
#   qsub -v N=2,RES=512,FIRST=100,OUT=/home/users/ntu/yhuang01/scratch/kubric_simple_512 ...
#
# Kubric runs in its own container (Blender + PyBullet), pulled once with
#   module load apptainer/1.5.0
#   apptainer pull ~/scratch/containers/kubruntu.sif docker://kubricdockerhub/kubruntu
#
#PBS -N kubric_simple
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=01:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/kubric_simple.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load apptainer/1.5.0

N=${N:-1}
FIRST=${FIRST:-0}
RES=${RES:-256}
OUT=${OUT:-$ROOT/kubric_simple_$RES}
ARGS=${ARGS:-}
SIF=$ROOT/containers/kubruntu.sif
mkdir -p $OUT

for i in $(seq $FIRST $((FIRST + N - 1))); do
  id=$(printf %06d $i)
  if [ -f $OUT/$id/$id.npy ]; then echo "skip $id"; continue; fi
  t0=$(date +%s)
  # Blender writes its raw renders to the scratch dir; keep that off the home quota.
  scratch=$(mktemp -d -p ${TMPDIR:-/tmp} kubric.XXXX)
  apptainer exec --nv --bind $ROOT $SIF python3 scripts/kubric_simple_worker.py \
    --job-dir $OUT/$id --scratch_dir $scratch --seed $i --resolution $RES --use_gpu $ARGS
  rm -rf $scratch
  echo "clip $id: $(( $(date +%s) - t0 )) s"
done
echo "=== KUBRIC SIMPLE DONE ==="
