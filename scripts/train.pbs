#!/bin/bash
# A training run: the current design (the flags' defaults), started from the
# dense reference, on our Kubric clips. ARGS holds what the experiment changes.
#
#   qsub -v OUT=fzP_name,ARGS="--rope-current 1" scripts/train.pbs
#   qsub -v OUT=...,CACHE=cache/kubric_dense,FRAMES=cache/kubric_frames384 scripts/train.pbs
#
#PBS -N train
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=08:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/train.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

OUT=${OUT:?}
ARGS=${ARGS:-}
CACHE=${CACHE:-cache/kubric_movi48q1}
FRAMES=${FRAMES:-cache/kubric_movi48_frames384}
INIT=${INIT:-outputs/fyT_dense_reference/best.pt}

# PBS writes its -o file only when the job ends: tail -f ~/scratch/$OUT.live.log
exec > >(tee -a $ROOT/${OUT}.live.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate
nvidia-smi --query-gpu=name,memory.total --format=csv

python -m genpoint3d.train.main --cache $ROOT/$CACHE --frames-cache $ROOT/$FRAMES --out outputs/$OUT \
  --init $INIT --fine-init $ROOT/weights/tapip3d_finder.pt $ARGS

echo "=== TRAIN DONE ==="
