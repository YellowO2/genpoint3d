#!/bin/bash
# The published TAPIP3D checkpoint on the TAPVid-3D half-clips that
# tapvid3d_score.pbs scores our model on: the same frames, queries, DA3 depth
# and intrinsics (scripts/ref_tapip3d.py --raw-kind tapvid3d), scored by
# scripts/score_ref_preds.py with evaluate.py's own scorer (--points 500, as
# our checkpoints were scored; every half-clip holds at most 8 queries).
#
#   qsub scripts/tapvid3d_ref.pbs
#   qsub -v CACHE=tapvid3d/pstudio_cache,RAW=tapvid3d/pstudio scripts/tapvid3d_ref.pbs
#
#PBS -N tapvid3d_ref
#PBS -l select=1:ncpus=8:ngpus=1:mem=48gb
#PBS -l walltime=02:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/tapvid3d_ref.log

set -euo pipefail
ROOT=$HOME/scratch
OURS=$ROOT/genpoint3d
REF=$ROOT/refs/tapip3d
C=$ROOT/${CACHE:-tapvid3d/pstudio_cache}
PREDS=$C/tapip3d_preds
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2

source $ROOT/venvs/tapip3d/bin/activate
python $OURS/scripts/ref_tapip3d.py --ref-repo $REF --clips $C/clips \
  --raw $ROOT/${RAW:-tapvid3d/pstudio} --raw-kind tapvid3d --out $PREDS
deactivate

source $ROOT/venvs/fyp/bin/activate
cd $OURS
python scripts/score_ref_preds.py --preds $PREDS --clips $C/clips --points 500 \
  --out $C/tapip3d_scores.json
echo "=== TAPVID3D REF DONE ==="
