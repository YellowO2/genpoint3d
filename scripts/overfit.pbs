#!/bin/bash
# Diagnostic, not a run: can the pipeline memorise 2 clips?
#
#   qsub -q normal -P personal-yhuang01 scripts/overfit.pbs
#
# Memorising a handful of clips is the easiest thing a network does, so this
# is one-sided and conclusive in the bad direction. APD should climb to ~100%.
# If it plateaus -- especially anywhere near the 21.8% static baseline -- then
# no data or capacity excuse is available and the pipeline has a bug.
#
# Uses the SAME cache, model and flags as run3493_disp, changing only the clip
# count. Testing a smaller model would clear a model we never trained.
#
#PBS -N overfit
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
# 2 clips, batch 2, 2000 steps, validating every 100 on those same 2 clips.
# Minutes on an A100. Walltime is a cap, not a reservation, so the hours cost
# nothing -- and asking for only one routed the job to `gdev`, whose overall
# ngpus limit was saturated ("would exceed overall limit on resource ngpus").
# Short jobs land in the development queue, which has far fewer GPUs than
# `normal`, so asking for LESS time made it schedule slower, not faster.
#PBS -l walltime=04:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/overfit.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

OUT=${OUT:-overfit2}
ARGS=${ARGS:-}

exec > >(tee -a $ROOT/${OUT}.live.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

nvidia-smi --query-gpu=name,memory.total --format=csv
git log --oneline -1 2>/dev/null || echo "(git unavailable on compute node)"

# --points 256 uses every cached point, so train and val see an IDENTICAL set
# and the score is pure memorisation with no resampling noise in it.
python scripts/train.py \
  --cache $ROOT/cache/kubric \
  --out outputs/$OUT \
  --overfit 2 \
  --target displacement \
  --steps 2000 --batch 2 --points 256 \
  --dim 256 --depth 6 --heads 4 \
  --val-every 100 --workers 2 $ARGS

echo "=== OVERFIT DONE ==="
