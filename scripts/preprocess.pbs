#!/bin/bash
# Build the training cache: decode PNGs + run DINOv3 over every frame, once.
# Safe to run while the download is still going -- incomplete clips are skipped.
#
#   qsub -q normal -P personal-yhuang01 scripts/preprocess.pbs
#
#PBS -N preprocess
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=01:30:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/preprocess.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

module load python/3.11.7-gcc11
source $ROOT/venvs/fyp/bin/activate
mkdir -p $ROOT/cache

python -c "import torch; print('cuda ok:', torch.cuda.is_available())"

python scripts/preprocess.py \
  --root $ROOT/kubric \
  --out  $ROOT/cache/kubric.pt \
  --features --feat-dim 256 --image-size 384 --points 256

echo "=== PREPROCESS DONE ==="
