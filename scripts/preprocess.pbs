#!/bin/bash
# Build the training cache: decode PNGs + run DINOv3 over every frame, once.
# Safe to run while the download is still going -- incomplete clips are skipped.
#
#   qsub -q normal -P personal-yhuang01 scripts/preprocess.pbs
#   qsub -v OUT=cache/kubric_768,ARGS="--image-size 768" ... scripts/preprocess.pbs
#
# Adding clips to the EXISTING cache needs no variables: preprocess.py skips what
# is already there. Keep the walltime under 2h for that and it routes to gdev,
# which leaves the single g1 slot free for training.
#
#PBS -N preprocess
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
# 4.0 s/clip measured on a shared A100, so 3500 clips is ~4h. Walltime is a cap,
# not a reservation -- the job ends when the script does. Over 2h routes to the
# g1 queue rather than gdev, which can mean a longer wait to start.
#PBS -l walltime=06:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/preprocess.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

# PBS only writes its -o file when the job ENDS. Tee to scratch so
# progress can be watched live with: tail -f ~/scratch/<name>.live.log
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
source $ROOT/venvs/fyp/bin/activate
mkdir -p $ROOT/cache

python -c "import torch; print('cuda ok:', torch.cuda.is_available())"

# Defaults reproduce the cache every run so far has used. ARGS comes last so a
# later --image-size or --layers wins, and preprocess.py refuses to resume a
# cache whose feature width does not match.
OUT=${OUT:-cache/kubric}
ARGS=${ARGS:-}

python scripts/preprocess.py \
  --root $ROOT/kubric \
  --out  $ROOT/$OUT \
  --features --image-size 384 --points 256 $ARGS

echo "=== PREPROCESS DONE ==="
