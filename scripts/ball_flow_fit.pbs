#!/bin/bash
# Whole-frame flow and a rigid fit on the spinning-ball clips, no model
# (scripts/ball_flow_fit.py). Renders the clips first (scripts/render_ball.py).
#
#   qsub scripts/ball_flow_fit.pbs
#
#PBS -N ball_flow_fit
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=00:45:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/ball_flow_fit.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

B=$ROOT/ball_test/raw_centres
[ -d $B ] || python scripts/render_ball.py --out $B --seeds ${SEEDS:-3}
python scripts/ball_flow_fit.py --clips $B --repo references/searaft/repo --weights $ROOT/weights/searaft-spring-M
echo "=== BALL FLOW FIT DONE ==="
