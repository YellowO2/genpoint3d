#!/bin/bash
# Does a ready one-picture shape model (TripoSR) know the unseen side of Kubric's objects (scripts/check_shape_prior.py)?
#
#   qsub scripts/shape_prior.pbs
#
#PBS -N shape_prior
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=01:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/shape_prior.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate
[ -d $ROOT/TripoSR ] || git clone -q --depth 1 https://github.com/VAST-AI-Research/TripoSR $ROOT/TripoSR
# What TripoSR's model code imports, kept beside it, away from the project's own environment.
[ -d $ROOT/TripoSR/deps ] || pip install -q --target $ROOT/TripoSR/deps omegaconf einops trimesh
python -c "import transformers, huggingface_hub" || pip install -q --target $ROOT/TripoSR/deps transformers huggingface_hub
export PYTHONPATH=$ROOT/TripoSR/deps:${PYTHONPATH:-} HF_HOME=$ROOT/hf
python scripts/check_shape_prior.py --made-up
python scripts/check_shape_prior.py --objects $ROOT/movi_objects --frames $ROOT/kubric --assets $ROOT/gso --triposr $ROOT/TripoSR \
  --clips ${CLIPS:-40} --out $ROOT/shape_prior 2>&1 | grep -v "Warn\|warn"
echo "=== SHAPE PRIOR DONE ==="
