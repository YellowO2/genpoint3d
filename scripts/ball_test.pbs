#!/bin/bash
# The spinning-ball test: render the clips (scripts/render_ball.py), cache
# them as the model reads them with their true depth (scripts/tapvid3d_cache.py),
# and score each run on each motion apart (scripts/evaluate.py --per-frame).
#
#   qsub -v CKPTS="outputs/fyT_dense_reference/best.pt outputs/fyV_fit_rounds/best.pt" scripts/ball_test.pbs
#
#PBS -N ball_test
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=01:30:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/ball_test.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

B=$ROOT/ball_test
if [ ! -d $B/cache ]; then
  python scripts/render_ball.py --out $B/raw --seeds ${SEEDS:-3}
  python scripts/tapvid3d_cache.py --src $B/raw --dst $B/cache --frames-dst $B/frames --every 1 \
    --depth-suffix .depth.npy
fi
for M in still slide spin_up_5 spin_up_10 spin_up_20 spin_side_10 spin_side_20 roll; do
  mkdir -p $B/by_motion/$M && rm -f $B/by_motion/$M/*.pt
  ln -s $B/cache/${M}_[0-9]*_q000_f.pt $B/by_motion/$M/
done
for CKPT in ${CKPTS:?}; do
  for M in still slide spin_up_5 spin_up_10 spin_up_20 spin_side_10 spin_side_20 roll; do
    echo "########## $CKPT  $M"
    python scripts/evaluate.py --ckpt "$CKPT" --cache $B/by_motion/$M --frames-cache $B/frames \
      --points 1000 --batch 1 --per-frame --out $B/score_$(basename $(dirname $CKPT))_$M.json \
      | grep -A10 "error against how far it has moved$" | head -11
  done
done
echo "=== BALL TEST DONE ==="
