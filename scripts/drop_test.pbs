#!/bin/bash
# Can a run forecast a ball's fall and bounce under real gravity? Render the
# dropping ball (render_ball.py --only drop), cache it, and score the forecast
# from frame 3 (the fall, then the bounces) and from frame 12 (the bounces).
#
#   qsub -v CKPT=outputs/fyP_prev_template/best.pt scripts/drop_test.pbs
#
#PBS -N drop_test
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=00:45:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/drop_test.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

B=$ROOT/drop_test
if [ ! -d $B/cache ]; then
  python scripts/render_ball.py --out $B/raw --seeds 3 --only drop
  python scripts/tapvid3d_cache.py --src $B/raw --dst $B/cache --frames-dst $B/frames --every 1 \
    --depth-suffix .depth.npy
  mkdir -p $B/q0 && ln -sf $B/cache/*_q000_f.pt $B/q0/
fi
for C in 3 12; do
  echo "## forecast from frame $C"
  python scripts/evaluate.py --ckpt ${CKPT:?} --cache $B/q0 --frames-cache $B/frames --points 1000 \
    --batch 1 --eval-cutoff $C 2>&1 | grep -E "apd_moving_obs|apd_moving_fut|apd_moving_stop_fut|apd_moving_cv_fut|apd_fut " || true
done
echo "=== DROP TEST DONE ==="
