#!/bin/bash
# TAPVid-3D clips ready to score: Depth Anything 3's depth (its own
# environment, scripts/da3_depth.py), then the clips as the model reads them
# (scripts/tapvid3d_cache.py).
#
#   qsub -v SRC=tapvid3d/pstudio,OUT=tapvid3d/pstudio_cache scripts/tapvid3d_prep.pbs
#
# Paths are relative to ~/scratch. Writes $OUT/clips and $OUT/frames.
#
#PBS -N tapvid3d_prep
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=01:30:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/tapvid3d_prep.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2

source $ROOT/venvs/da3/bin/activate
python scripts/da3_depth.py --clips $ROOT/${SRC:?}
deactivate

source $ROOT/venvs/fyp/bin/activate
python scripts/tapvid3d_cache.py --src $ROOT/$SRC --dst $ROOT/${OUT:?}/clips \
  --frames-dst $ROOT/$OUT/frames --every ${EVERY:-8}
echo "=== TAPVID3D PREP DONE ==="
