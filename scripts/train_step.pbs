#!/bin/bash
# Train the step tracker (scripts/train_step.py), then score it chained over
# the spinning-ball clips by motion and over Kubric validation clips
# (scripts/eval_step.py).
#
#   qsub -v OUT=step_a scripts/train_step.pbs
#
#PBS -N train_step
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=04:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/train_step.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

O=outputs/${OUT:?}
[ -f $O/step.pt ] && [ -z "${RETRAIN:-}" ] || python scripts/train_step.py --cache $ROOT/cache/kubric_dense \
  --frames-cache $ROOT/cache/kubric_frames384 --fine-init $ROOT/weights/tapip3d_finder.pt --out $O \
  --steps ${STEPS:-1500}
for M in slide spin_up_5 spin_up_10 spin_up_20 spin_side_10 spin_side_20 roll; do
  echo "########## ball $M"
  python scripts/eval_step.py --ckpt $O/step.pt --cache $ROOT/ball_test/by_motion/$M \
    --frames-cache $ROOT/ball_test/frames | grep -v "^\s*$" || true
done
echo "########## kubric val"
python scripts/eval_step.py --ckpt $O/step.pt --cache $ROOT/fit_check/tuV/val \
  --frames-cache $ROOT/cache/kubric_frames384 --points 500 || true
echo "=== STEP TRACKER DONE ==="
