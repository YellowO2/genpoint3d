#!/bin/bash
# Where forecasting fails: at rest, smooth motion or impact (scripts/forecast_split.py).
#
#   qsub -v CKPT=outputs/fyT_dense_reference/best.pt,CACHE=fit_check/tuV/val scripts/forecast_split.pbs
#
#PBS -N forecast_split
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=00:45:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/forecast_split.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

python scripts/forecast_split.py --ckpt "$CKPT" --cache $ROOT/${CACHE:?} \
  --frames-cache $ROOT/${FRAMES:-cache/kubric_frames384} --points ${POINTS:-500}
