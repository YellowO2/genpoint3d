#!/bin/bash
# Model-free check of the inputs: does nearest-feature matching find moving
# points? See scripts/match_baseline.py. Minutes; no training.
#
#   qsub scripts/match_baseline.pbs
#
#PBS -N match_base
#PBS -l select=1:ncpus=8:ngpus=1:mem=48gb
#PBS -l walltime=00:40:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/match_base.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

N=${N:-100}
for CACHE in $ROOT/cache/kubric $ROOT/cache/kubric_768_3493; do
  python scripts/match_baseline.py --cache "$CACHE" --n "$N"
done
echo "=== MATCH BASELINE DONE ==="
