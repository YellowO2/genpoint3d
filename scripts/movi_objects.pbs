#!/bin/bash
# Every old Kubric clip's objects from its MOVi-F twin (scripts/movi_objects.py), then each
# point's object and centre written into the raw clips and the caches (scripts/label_old_kubric.py).
#
#   qsub -v "CACHES=cache/kubric_dense cache/kubric_more_dense" scripts/movi_objects.pbs
#
#PBS -N movi_objects
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=06:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/movi_objects.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
R=$ROOT/movi_f/256x256/1.0.0
source $ROOT/venvs/movi/bin/activate
python scripts/movi_objects.py --root $R --split validation --shards 0 32 --old $ROOT/kubric --out $ROOT/movi_objects &
for k in $(seq 0 14); do
  python scripts/movi_objects.py --root $R --shards $(( k * 69 )) $(( k == 14 ? 1024 : (k + 1) * 69 )) --old $ROOT/kubric --out $ROOT/movi_objects &
done
wait
deactivate
source $ROOT/venvs/fyp/bin/activate
echo "$(ls $ROOT/movi_objects | wc -l) of $(ls $ROOT/kubric | wc -l) old clips have a twin"
python scripts/label_old_kubric.py --old $ROOT/kubric --objects $ROOT/movi_objects --write --caches $(for c in ${CACHES:-}; do echo $ROOT/$c; done)
echo "=== MOVI OBJECTS DONE ==="
