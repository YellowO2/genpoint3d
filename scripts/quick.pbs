#!/bin/bash
# Short training run for an early signal. Reads whatever clips are cached so
# far, so it can run while preprocessing is still going.
#
#   qsub -q normal -P personal-yhuang01 scripts/quick.pbs
#
#PBS -N quick
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=00:40:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/quick.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/quick.live.log) 2>&1

module load python/3.11.7-gcc11
source $ROOT/venvs/fyp/bin/activate

echo "cached clips: $(ls $ROOT/cache/kubric | wc -l)"

python scripts/train.py \
  --cache $ROOT/cache/kubric \
  --out outputs/quick \
  --steps 3000 --batch 16 --points 128 \
  --val-frac 0.15 --val-every 500 --warmup 200

echo "=== QUICK DONE ==="
