#!/bin/bash
# Points carried by optical flow alone, scored like a run (scripts/flow_chain.py).
#
#   qsub -v CACHE=fit_check/tuO/val scripts/flow_chain.pbs
#
# Paths are relative to ~/scratch. Prints the depth floor (true pixels), the
# chained flow, then each point moved with its object.
#
#PBS -N flow_chain
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=00:30:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/flow_chain.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
source $ROOT/venvs/fyp/bin/activate

A="--cache $ROOT/${CACHE:?} --frames $ROOT/cache/kubric_frames384 --flow $ROOT/cache/kubric_flow384"
# MODES="--truth|none|--object", run in turn ("none" is the plain chain).
for M in ${MODES:---truth none --object}; do
  python scripts/flow_chain.py $A $([ "$M" = none ] || echo $M)
done

echo "=== FLOW CHAIN DONE ==="
