#!/bin/bash
# Backfill norm + intrinsics into an existing cache. CPU only -- no GPU is
# requested, so this routes to the CPU queue rather than queueing behind GPU work.
#
#   qsub -q normal -P personal-yhuang01 scripts/patch_cache.pbs
#
#PBS -N patchcache
#PBS -l select=1:ncpus=16:mem=32gb
# Measured 5.35 s/clip on a LOADED LOGIN NODE with only 10 clips, which is a
# pessimistic sample; full preprocessing managed 2.07 s/clip on a compute node
# doing strictly more work. Somewhere in between is likely, so allow for the
# bad case -- walltime is a cap, not a reservation, and the job ends when the
# script does.
#PBS -l walltime=06:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/patchcache.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

# PBS only writes its -o file when the job ENDS. Tee to scratch so
# progress can be watched live with: tail -f ~/scratch/patchcache.live.log
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
source $ROOT/venvs/fyp/bin/activate

python scripts/patch_cache.py \
  --cache $ROOT/cache/kubric \
  --root  $ROOT/kubric \
  --workers 16

echo "=== PATCH DONE ==="
