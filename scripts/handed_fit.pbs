#!/bin/bash
# Is the fit each round is handed any good (scripts/handed_fit.py)? On the standard test's clips and the ball.
#
#   qsub -v CKPT=outputs/RUN/best.pt scripts/handed_fit.pbs
#
#PBS -N handed_fit
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=00:40:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/handed_fit.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate
CKPT=${CKPT:?}
for spec in "ball_test/by_motion/spin_up_10 ball_test/frames 100000" \
            "fit_check/std_fyP_0/val cache/kubric_frames384 256"; do
  set -- $spec
  python scripts/handed_fit.py --ckpt $CKPT --cache $ROOT/$1 --frames-cache $ROOT/$2 --points $3 2>&1 | grep -v "Warn\|warn" || true
done
echo "=== HANDED FIT DONE ==="
