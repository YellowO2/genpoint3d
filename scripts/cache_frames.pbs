#!/bin/bash
# Cache the RGB frames of every clip in a feature cache, at the size the
# relative finder's CNN reads them (train.py --fine 1 --frames-cache ...).
# No GPU: PNGs are decoded, shrunk and written. The feature cache is only
# listed, so a training job can keep reading it.
#
#   qsub -v SRC=cache/kubric_ctr,DST=cache/kubric_frames384 scripts/cache_frames.pbs
#   qsub -v SRC=cache/kubric_test,DST=cache/kubric_test_frames384,RAW=kubric_test scripts/cache_frames.pbs
#
# Paths are relative to ~/scratch. RAW defaults to the training download. The
# frames do not depend on the feature grid, so one frames cache serves the
# 24-grid and the 48-grid cache alike; if one of them holds a clip the other
# lacks, run this again with that SRC and the same DST and only the missing
# clips are written. Resubmitting the same command resumes likewise.
#
#PBS -N cache_frames
#PBS -l select=1:ncpus=16:mem=32gb
# Per clip: read and decode 24 PNGs, write one 10.6 MB file (at 384 px). Well
# under a second of CPU; on Lustre allow a few seconds. With 16 workers 3500
# clips should take 10-20 min and 37 GB. Walltime is a cap, not a reservation.
#PBS -l walltime=01:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/cache_frames.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

# PBS only writes its -o file when the job ENDS. Tee to scratch so
# progress can be watched live with: tail -f ~/scratch/<name>.live.log
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
source $ROOT/venvs/fyp/bin/activate

SRC=${SRC:?set SRC, e.g. -v SRC=cache/kubric_ctr,DST=cache/kubric_frames384}
DST=${DST:?set DST, the frames directory to write}
RAW=${RAW:-kubric}
RES=${RES:-384}

# 16 processes each reading 24 files; 4 read threads apiece is plenty.
export KUBRIC_READ_WORKERS=4

python scripts/cache_frames.py \
  --src $ROOT/$SRC \
  --raw $ROOT/$RAW \
  --dst $ROOT/$DST \
  --res $RES \
  --workers 16

echo "=== CACHE FRAMES DONE ==="
