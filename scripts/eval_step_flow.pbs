#!/bin/bash
# The step tracker with SEA-RAFT's flow for its steps and its own learned
# groups (scripts/eval_step.py --flow), on the spinning ball and Kubric val.
#
#   qsub -v CKPT=outputs/step_a/step.pt scripts/eval_step_flow.pbs
#
#PBS -N eval_step_flow
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=02:05:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/eval_step_flow.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

python scripts/cache_flow.py --frames $ROOT/ball_test/frames --dst $ROOT/ball_test/flow \
  --repo references/searaft/repo --weights $ROOT/weights/searaft-spring-M
for M in slide spin_up_5 spin_up_10 spin_up_20 spin_side_10 spin_side_20 roll; do
  echo "########## ball $M"
  python scripts/eval_step.py --ckpt ${CKPT:?} --cache $ROOT/ball_test/by_motion/$M \
    --frames-cache $ROOT/ball_test/frames --flow $ROOT/ball_test/flow | grep -v "^\s*$" || true
done
echo "########## kubric val"
python scripts/eval_step.py --ckpt $CKPT --cache $ROOT/fit_check/tuV/val \
  --frames-cache $ROOT/cache/kubric_frames384 --flow $ROOT/cache/kubric_flow384 --points 500 || true
echo "=== EVAL STEP FLOW DONE ==="
