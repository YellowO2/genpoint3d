#!/bin/bash
# Where the training step's 24 GB actually goes. Short, so it routes to gdev.
#
#   qsub -q normal -P personal-yhuang01 scripts/profile_memory.pbs
#
#PBS -N profmem
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=00:30:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/profmem.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

python scripts/profile_memory.py --cache $ROOT/cache/kubric --batch 16

echo "=== PROFILE DONE ==="
