#!/bin/bash
# Does a run send points round to the ball's hidden back? (scripts/ball_backside.py)
#
#   qsub -v CKPT=outputs/fyT_dense_reference/best.pt scripts/ball_backside.pbs
#
#PBS -N ball_backside
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=00:30:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/ball_backside.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate
for M in spin_up_5 spin_up_10 spin_side_10 roll; do
  python scripts/ball_backside.py --ckpt ${CKPT:?} --cache $ROOT/ball_test/by_motion/$M \
    --frames-cache $ROOT/ball_test/frames --raw $ROOT/ball_test/raw_centres 2>&1 | grep -v "Warn\|warn" | tail -3 || true
done
