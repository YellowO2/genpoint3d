#!/bin/bash
# On the ball clips, a run's error by how the point faces the camera: facing,
# oblique, at the edge, seen again after hiding, hidden (scripts/ball_view_angle.py).
#
#   qsub -v CKPT=outputs/fyT_dense_reference/best.pt scripts/ball_view_angle.pbs
#
#PBS -N ball_view_angle
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=00:30:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/ball_view_angle.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate
for M in ${MOTIONS:-spin_up_10}; do
  python scripts/ball_view_angle.py --ckpt ${CKPT:?} --cache $ROOT/ball_test/by_motion/$M \
    --frames-cache $ROOT/ball_test/frames --raw $ROOT/ball_test/raw_centres ${EXTRA:-} 2>&1 | grep -v "Warn\|warn" | tail -7 || true
done
