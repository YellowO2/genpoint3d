#!/bin/bash
# Moving points' error split into always seen, seen again after hiding, and
# hidden, by frame (scripts/return_split.py), on the standard 100 val clips.
#
#   qsub -v CKPT=outputs/fyP_prev_template/best.pt scripts/return_split.pbs
#
#PBS -N return_split
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=00:45:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/return_split.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate
python scripts/return_split.py --ckpt ${CKPT:?} --cache $ROOT/${CACHE:-fit_check/std_fyP_0/val} \
  --frames-cache $ROOT/cache/kubric_frames384 --points 256 2>&1 | grep -v "Warn\|warn"
