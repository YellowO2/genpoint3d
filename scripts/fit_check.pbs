#!/bin/bash
# Is the model underfitting or failing to generalise?
#
#   qsub -v CKPT=outputs/run7_30k/best.pt scripts/fit_check.pbs
#
# Scores one checkpoint twice with identical code: on 50 clips it TRAINED on,
# and on 50 clips it validated on. Only the data differs, so the two numbers
# are directly comparable.
#
#   train APD ~= val APD  -> it cannot fit even what it has seen. High bias:
#                            capacity/resolution/architecture is the lever.
#   train APD >> val APD  -> it fits and fails to generalise. High variance:
#                            more data is the lever.
#
# Training logs cannot answer this: train loss is a running average taken while
# the model is still changing, and at step 2000 it reads HIGHER than val loss,
# so the two loss curves are not the same quantity.
#
#PBS -N fit_check
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=01:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/fit_check.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

CKPT=${CKPT:-outputs/run7_30k/best.pt}
CACHE=${CACHE:-$ROOT/cache/kubric}
N=${N:-50}
# SPACE=2d projects both tracks into the image and scores pixel thresholds, so
# depth error stops counting. Run both and the pair says whether depth is what
# we get wrong.
SPACE=${SPACE:-3d}
# AXIS=x|y|z overwrites that channel of the prediction with the truth before
# scoring. Run all three: correcting any one axis removes part of the error
# budget, so z is only the culprit if it buys more than x and y do.
AXIS=${AXIS:-}
[ -n "$AXIS" ] && OZ="--oracle-axis $AXIS" || OZ=""
WORK=$ROOT/fit_check

# val_frac and seed must match the run's run.json, or these are not the clips
# it actually trained on.
for SPLIT in train val; do
  python scripts/split_dir.py --cache "$CACHE" --split $SPLIT --n "$N" \
    --val-frac 0.1 --seed 0 --out "$WORK/$SPLIT"
done

for SPLIT in train val; do
  echo
  echo "########## $SPLIT split, $SPACE score${AXIS:+, true $AXIS} ($N clips) ##########"
  python scripts/evaluate.py --ckpt "$CKPT" --cache "$WORK/$SPLIT" \
    --space "$SPACE" $OZ \
    --out "$(dirname "$CKPT")/fit_check_${SPLIT}_${SPACE}${AXIS:+_oracle$AXIS}.json"
done

echo "=== FIT CHECK DONE ==="
