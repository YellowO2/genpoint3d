#!/bin/bash
# 2D against depth error of a run on the spinning-ball motions (scripts/error_split.py).
#
#   qsub -v CKPT=outputs/fyT_dense_reference/best.pt scripts/error_split.pbs
#
#PBS -N error_split
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=00:45:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/error_split.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate
for M in slide spin_up_5 spin_up_10 spin_side_10 roll spin_up_20; do
  python scripts/error_split.py --ckpt "${CKPT:?}" --cache $ROOT/ball_test/by_motion/$M \
    --frames-cache $ROOT/ball_test/frames 2>&1 | grep "point-frames" || true
done
echo "=== ERROR SPLIT DONE ==="
