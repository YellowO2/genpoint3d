#!/bin/bash
# Score the published 4RC checkpoint on our validation clips, with our scorer.
# See scripts/ref_4rc.py. The environment and checkpoint come from
# ~/scratch/4rc_setup.sh (one-time, on the login node).
#
#   qsub scripts/ref_4rc.pbs
#
#PBS -N ref_4rc
#PBS -l select=1:ncpus=8:ngpus=1:mem=48gb
#PBS -l walltime=01:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/ref_4rc.log

set -euo pipefail
ROOT=$HOME/scratch
OURS=$ROOT/genpoint3d
REF=$ROOT/refs/4rc
N=${N:-100}
ARGS=${ARGS:-}
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2

# The same val clips our own runs are scored on, picked by our own split code.
# Made once and then left alone, so a TAPIP3D job reading it is not disturbed.
if [ ! -d $ROOT/ref_eval/val$N ]; then
  source $ROOT/venvs/fyp/bin/activate
  python $OURS/scripts/split_dir.py --cache $ROOT/cache/kubric --split val --n "$N" \
    --val-frac 0.1 --seed 0 --out $ROOT/ref_eval/val$N
  deactivate
fi

source $ROOT/venvs/4rc/bin/activate
python $OURS/scripts/ref_4rc.py --ref-repo $REF --clips $ROOT/ref_eval/val$N \
  --raw $ROOT/kubric --out $ROOT/ref_preds/4rc $ARGS
echo "=== REF 4RC DONE ==="
