#!/bin/bash
# Measure the batch size that saturates the GPU, before committing to a long run.
#
#   qsub -q normal -P personal-yhuang01 scripts/bench_batch.pbs
#
# Under 2h and one GPU, so this routes to gdev and usually starts quickly.
#
#PBS -N benchbatch
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=01:30:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/benchbatch.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

nvidia-smi --query-gpu=name,memory.total --format=csv

# workers first, then batch: fixing the input pipeline moves where the batch
# wall sits, so sweeping batch against a starved loader measures the wrong thing.
# workers=0 is measured only at batch 16 -- it is slow enough that sweeping it
# across every batch size eats the walltime for a baseline we already expect.
python scripts/bench_batch.py \
  --cache $ROOT/cache/kubric \
  --workers 0 --batches 16 \
  --points 128 --dim 256 --depth 6 --heads 4

python scripts/bench_batch.py \
  --cache $ROOT/cache/kubric \
  --workers 4 8 16 \
  --batches 16 32 64 128 \
  --points 128 --dim 256 --depth 6 --heads 4

echo "=== BENCH DONE ==="
