#!/bin/bash
# Snapshot (MODE=save) or check (MODE=check) what the kept checkpoints predict,
# around a code cleanup (scripts/snapshot.py): the ball model on old Kubric,
# tracking and forecast from 12; the design run on our clips, tracking and
# forecast from 5.
#
#   qsub -v MODE=save scripts/snapshot.pbs      # before
#   qsub -v MODE=check scripts/snapshot.pbs     # after
#
#PBS -N snapshot
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=00:20:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/snapshot.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate
S=$ROOT/snapshot && mkdir -p $S
flag() { [ "${MODE:?}" = save ] && echo "--out $S/$1.pt" || echo "--against $S/$1.pt"; }
for C in 0 12; do
  python scripts/snapshot.py --ckpt outputs/fyT_dense_reference/best.pt --cache $ROOT/fit_check/std_fyP_0/val \
    --frames-cache $ROOT/cache/kubric_frames384 --clips 6 --cutoff $C $(flag fyT_c$C) 2>&1 | grep -v "Warn\|warn"
done
for C in 0 5; do
  python scripts/snapshot.py --ckpt outputs/fzN_scene_points_any_frame/best.pt --cache $ROOT/fall_test/val \
    --frames-cache $ROOT/cache/kubric_movi48_frames384 --clips 4 --cutoff $C $(flag fzN_c$C) 2>&1 | grep -v "Warn\|warn"
done
echo "=== SNAPSHOT $MODE DONE ==="
