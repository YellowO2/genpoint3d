#!/bin/bash
# Draw a checkpoint's tracks over the RGB frames of the first val clips, as mp4s.
#
#   qsub -v CKPT=outputs/run33_fine_xyz_48/best.pt,CACHE=$HOME/scratch/cache/kubric_768_3493_ctr,FRAMES=cache/kubric_frames384,CLIPS=6,OUT=renders/run33 \
#        -q normal -P personal-yhuang01 scripts/render_tracks.pbs
#
# Writes ~/scratch/$OUT/<clip>.mp4 and <clip>.png (a 6-frame contact sheet),
# and prints each clip's moving-point APD to match the videos to.
#
#PBS -N render
#PBS -l select=1:ncpus=16:ngpus=1:mem=110gb
#PBS -l walltime=00:20:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/render.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

CKPT=${CKPT:-outputs/run33_fine_xyz_48/best.pt}
CACHE=${CACHE:-$ROOT/cache/kubric_768_3493_ctr}
# The RGB frames cache, relative to ~/scratch, at the checkpoint's --fine-res.
FRAMES=${FRAMES:-cache/kubric_frames384}
CLIPS=${CLIPS:-6}
OUT=${OUT:-renders/pred}
# More flags, e.g. EXTRA="--eval-cutoff 12 --points 24". Spaces, not commas:
# `qsub -v` splits on commas.
EXTRA=${EXTRA:-}

mkdir -p $ROOT/$OUT
exec > >(tee -a $ROOT/$OUT/render.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

nvidia-smi --query-gpu=name --format=csv,noheader

python scripts/render_tracks.py \
  --ckpt $CKPT \
  --cache $CACHE \
  --frames-cache $ROOT/$FRAMES \
  --clips $CLIPS \
  --out $ROOT/$OUT $EXTRA

echo "=== RENDER DONE -- scp -r ~/scratch/$OUT to your machine ==="
