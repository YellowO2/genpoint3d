#!/bin/bash
# What a training step costs: batch sweep, then where the memory goes.
#
#   qsub -q normal -P personal-yhuang01 scripts/bench.pbs
#   qsub -v WHAT=memory -q normal -P personal-yhuang01 scripts/bench.pbs
#
# Under 2h and one GPU, so this routes to gdev and usually starts quickly.
#
#PBS -N bench
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=01:30:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/bench.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

WHAT=${WHAT:-all}

exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

nvidia-smi --query-gpu=name,memory.total --format=csv

COMMON="--cache $ROOT/cache/kubric --points 128 --dim 256 --depth 6 --heads 4"

if [ "$WHAT" = "all" ] || [ "$WHAT" = "speed" ]; then
  # workers first, then batch: fixing the input pipeline moves where the batch
  # wall sits, so sweeping batch against a starved loader measures the wrong
  # thing. workers=0 is measured only at batch 16 -- slow enough that sweeping
  # it across every batch size eats the walltime for a baseline we expect.
  python scripts/bench.py $COMMON --what speed --workers 0  --batches 16
  python scripts/bench.py $COMMON --what speed --workers 4 8 16 --batches 16 32 64 128
fi

if [ "$WHAT" = "all" ] || [ "$WHAT" = "memory" ]; then
  python scripts/bench.py $COMMON --what memory --batch 16
  python scripts/bench.py $COMMON --what sweep  --batch 16
fi

echo "=== BENCH DONE ==="
