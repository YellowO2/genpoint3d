#!/bin/bash
# A quick TAPVid-3D check: score checkpoints on the clips tapvid3d_prep.pbs
# made, each forward or backward half scored as its own clip by
# scripts/evaluate.py (our APD, median rescale), not the benchmark's own
# metric over whole tracks.
#
#   qsub -v CKPTS="outputs/fyT_dense_reference/best.pt",CACHE=tapvid3d/pstudio_cache scripts/tapvid3d_score.pbs
#
#PBS -N tapvid3d_score
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=01:30:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/tapvid3d_score.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

C=$ROOT/${CACHE:-tapvid3d/pstudio_cache}
for CKPT in ${CKPTS:?}; do
  echo "########## $CKPT"
  python scripts/evaluate.py --ckpt "$CKPT" --cache $C/clips --frames-cache $C/frames \
    --batch 1 --out $(dirname $CKPT)/tapvid3d_pstudio.json \
    | grep -E "average_pts_within|apd_static|moving_frac|average_jaccard|occlusion_acc|apd_moving_hidden |pts_within_" || true
done
echo "=== TAPVID3D SCORE DONE ==="
