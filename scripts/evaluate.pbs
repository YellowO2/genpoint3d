#!/bin/bash
# Score a checkpoint on the held-out TEST cache (sequences 3500+).
#
#   qsub -v CKPT=outputs/RUN/best.pt,FRAMES=cache/kubric_test_frames384 scripts/evaluate.pbs
#   qsub -v CKPT=...,FRAMES=...,CUTOFF=12,ARGS=--ablate scripts/evaluate.pbs
#
#PBS -N evaluate
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=01:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/evaluate.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d

exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

# best.pt was selected on the VAL split, so its val APD is mildly optimistic.
# This cache chose nothing, which is what makes its number reportable.
CKPT=${CKPT:?}
ARGS=${ARGS:-}
# FRAMES (relative to ~/scratch): the RGB and depth cache of the TEST clips.
FRAMES=${FRAMES:?}
# CUTOFF=12 forecasts: frames 12 on get no image, scored apart (_obs, _fut).
CUTOFF=${CUTOFF:-}
if [ -n "$CUTOFF" ]; then ARGS="--eval-cutoff $CUTOFF $ARGS"; fi

python scripts/evaluate.py \
  --ckpt "$CKPT" --per-frame $ARGS \
  --cache $ROOT/cache/kubric_test --frames-cache $ROOT/$FRAMES \
  --out "$(dirname "$CKPT")/test_metrics${CUTOFF:+_c$CUTOFF}.json"

echo "=== EVALUATE DONE ==="
