#!/bin/bash
# How well a --rigid-fit run's groups match the truth (scripts/check_groups.py).
#
#   qsub -v CKPT=outputs/fyV_fit_rounds/best.pt,CACHE=fit_check/tuV/val scripts/check_groups.pbs
#
#PBS -N check_groups
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=00:45:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/check_groups.log

set -euo pipefail
ROOT=$HOME/scratch
cd $ROOT/genpoint3d
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1
module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

python scripts/check_groups.py --ckpt "$CKPT" --cache $ROOT/${CACHE:?} \
  --frames-cache $ROOT/${FRAMES:-cache/kubric_frames384} --points ${POINTS:-500}
