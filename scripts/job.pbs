#!/bin/bash
# NSCC ASPIRE 2A -- preprocess (DINOv3) then train, in one job.
#
# Submit with:  qsub scripts/job.pbs
#
# Queue routing is automatic from the resources requested. "-q ai" + ngpus=1
# lands in aiq1, which allows any walltime from 1s to 24h. Do NOT use
# "-q normal" for a GPU job shorter than 2h -- g1 has a 2-hour MINIMUM and a
# job under it is rejected rather than queued.
#
#PBS -N genpoint3d
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=06:00:00
#PBS -q ai
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/scratch/genpoint3d/outputs/

set -euo pipefail

ROOT=$HOME/scratch
cd $ROOT/genpoint3d

module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

mkdir -p outputs $ROOT/cache

echo "=== node ==="
nvidia-smi
python -c "import torch; print('torch', torch.__version__, '| cuda available', torch.cuda.is_available())"

CACHE=$ROOT/cache/kubric500.pt

# --- preprocess: only if the cache is not already built -------------------
if [ ! -f "$CACHE" ]; then
  echo "=== preprocess (DINOv3 features) ==="
  python scripts/preprocess.py \
    --root $ROOT/kubric \
    --out  $CACHE \
    --features --feat-dim 256 --image-size 384 --points 256
else
  echo "=== cache exists, skipping preprocess ==="
fi

# --- train ----------------------------------------------------------------
echo "=== train ==="
python scripts/train.py \
  --cache $CACHE \
  --out outputs/run500 \
  --steps 20000 --batch 16 --points 128 \
  --dim 256 --depth 6 --heads 4 \
  --val-every 1000

echo "=== done ==="
