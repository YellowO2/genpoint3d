#!/bin/bash
# NSCC ASPIRE 2A -- preprocess (DINOv3) then train, in one job.
#
# Submit with:  qsub scripts/job.pbs
#
# The "ai" queue REJECTS personal projects, so this uses "normal". Routing is
# then automatic from the resources requested:
#     ngpus=1, walltime >  2h  -> g1
#     ngpus=1, walltime <= 2h  -> gdev
# A job matching neither is rejected outright rather than queued.
#
#PBS -N genpoint3d
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=08:00:00
#PBS -q normal
#PBS -P personal-yhuang01
#PBS -j oe
#PBS -o /home/users/ntu/yhuang01/scratch/genpoint3d/outputs/

set -euo pipefail

ROOT=$HOME/scratch
cd $ROOT/genpoint3d

# PBS only writes its -o file when the job ENDS. Tee to scratch so
# progress can be watched live with: tail -f ~/scratch/<name>.live.log
exec > >(tee -a $ROOT/${PBS_JOBNAME:-job}.live.log) 2>&1

module load python/3.11.7-gcc11
module load cuda/12.2.2
source $ROOT/venvs/fyp/bin/activate

mkdir -p outputs $ROOT/cache

echo "=== node ==="
nvidia-smi
python -c "import torch; print('torch', torch.__version__, '| cuda available', torch.cuda.is_available())"

CACHE=$ROOT/cache/kubric

# --- preprocess: only if the cache is not already built -------------------
if [ ! -d "$CACHE" ] || [ -z "$(ls -A $CACHE 2>/dev/null)" ]; then
  echo "=== preprocess (DINOv3 features) ==="
  python scripts/preprocess.py \
    --root $ROOT/kubric \
    --out  $CACHE \
    --features --feat-dim 256 --image-size 384 --points 256
else
  echo "=== cache exists, skipping preprocess ==="
fi

# --- train ----------------------------------------------------------------
echo "=== train ==="
python scripts/train.py \
  --cache $CACHE \
  --out outputs/run500 \
  --steps 20000 --batch 16 --points 128 \
  --dim 256 --depth 6 --heads 4 \
  --val-every 1000

echo "=== done ==="
