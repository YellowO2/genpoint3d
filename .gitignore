# Everything machine-local: datasets, caches, run outputs. Large, regenerable,
# never committed. One directory so the tracked/untracked line is obvious.
/local/


# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Editors / OS
.DS_Store
.idea/
.vscode/


# Copyrighted paper text — kept local, not redistributed
/docs/refs/

# Rerun recordings, rendered from checkpoints and re-creatable at will.
*.rrd

# Secrets. Never commit.
.env

# Checkpoints and logs written by the PBS jobs on the cluster. Ignored so that
# `git clean -fd` cannot delete them -- it did once, taking every checkpoint.
/outputs/

# Cloned reference repos. Notes beside them are tracked; the clones are not.
/references/*/repo/
